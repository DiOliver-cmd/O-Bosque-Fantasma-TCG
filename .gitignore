# ============================================================
# O Bosque Fantasma — .gitignore
# ============================================================

# Arquivos privados (não subir para o repositório)
_private/

# Screenshots / previews visuais
screenshot.png
screenshot-viewport.png
*-preview.png

# Inventário e dados de importação (contém preços/custos)
*.xlsx
*.csv

# Logo (arquivo binário, subir via admin do WP)
assets/images/logo.jfif
assets/images/*.jfif

# Dependências
node_modules/

# Cache / temp
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# WordPress
wp-config.php
